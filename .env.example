# MySQL connection string used by Prisma (e.g. PlanetScale, Railway, Aiven, RDS)
DATABASE_URL="mysql://user:password@host:3306/urmila_clinic"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Vercel Blob (file uploads) — auto-populated when you enable Blob storage
# in your Vercel project's Storage tab; for local dev, copy the token from
# Vercel dashboard -> Storage -> your Blob store -> .env.local tab.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"
